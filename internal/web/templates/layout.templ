package templates

templ Layout(active, crumb, title, subtitle string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Rolodex</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<div class="app">
				<aside class="sidebar">
					<div class="brand"><img src="/static/rolodex_mini.png" alt="" class="brand-icon"/>Rolodex</div>
					@navLink("today", "/", "Today", active)
					@navLink("people", "/people", "People", active)
					@navLink("circles", "/circles", "Circles", active)
					@navLink("events", "/events", "Visits & events", active)
					<div class="nav-section">Workspace</div>
					@navLink("reminders", "/reminders", "Reminders", active)
				</aside>
				<div class="main">
					<div class="topbar">
						<input type="search" placeholder="Search... (⌘K)" style="width:220px"/>
					</div>
					<div class="crumb">{ crumb }</div>
					<h1>{ title }</h1>
					if subtitle != "" {
						<div class="subtitle">{ subtitle }</div>
					}
					{ children... }
				</div>
			</div>
		</body>
	</html>
}

templ navLink(id, href, label, active string) {
	if active == id {
		<a class="nav-link active" href={ templ.URL(href) }>{ label }</a>
	} else {
		<a class="nav-link" href={ templ.URL(href) }>{ label }</a>
	}
}
