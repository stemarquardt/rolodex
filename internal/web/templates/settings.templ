package templates

import (
	"rolodex/internal/model"
)

// settingsCategories drives both the Settings page layout and which
// category each add-form posts to. Keep in sync with the category
// constants in internal/model/optionvalue.go and the seed list in
// internal/db/seed.go.
var settingsCategories = []struct {
	Category string
	Title    string
}{
	{model.CategoryEventKind, "Event kinds"},
	{model.CategoryEventStatus, "Event statuses"},
	{model.CategoryContactInfoType, "Contact info types"},
	{model.CategoryImportantDateType, "Important date types"},
}

templ SettingsPage(options map[string][]model.OptionValue, relTypes []model.RelationshipType) {
	@Layout("settings", "Rolodex", "Settings", "Manage the option lists behind the dropdowns elsewhere in the app.") {
		@SettingsOptionsBody(options)
		@SettingsRelationshipTypesBody(relTypes)
	}
}

templ SettingsOptionsBody(options map[string][]model.OptionValue) {
	<div id={ settingsOptionsBodyID }>
		for _, cat := range settingsCategories {
			@SettingsCategoryPanel(cat.Category, cat.Title, options[cat.Category])
		}
	</div>
}

templ SettingsCategoryPanel(category, title string, items []model.OptionValue) {
	<div class="panel">
		<div class="section-title">{ title }</div>
		if len(items) == 0 {
			<div class="muted">No values yet.</div>
		}
		for _, v := range items {
			<div class="list-row">
				<span style="flex:1;">{ v.Value }</span>
				<button
					class="btn"
					hx-delete={ settingsOptionDeleteURL(v.ID) }
					hx-target={ "#" + settingsOptionsBodyID }
					hx-swap="outerHTML"
					hx-confirm="Remove this option? Existing records that already used it keep it, but it won't show up as a choice anymore."
				>
					Remove
				</button>
			</div>
		}
		<form
			class="inline-form"
			hx-post={ settingsOptionCreateURL() }
			hx-target={ "#" + settingsOptionsBodyID }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input type="hidden" name="category" value={ category }/>
			<input type="text" name="value" placeholder="Add a value..." required/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ SettingsRelationshipTypesBody(relTypes []model.RelationshipType) {
	<div id={ settingsRelationshipTypesBodyID } class="panel">
		<div class="section-title">Relationship types</div>
		if len(relTypes) == 0 {
			<div class="muted">No relationship types yet.</div>
		}
		for _, rt := range relTypes {
			<div class="list-row">
				<span style="flex:1;">{ rt.Name } / { rt.NameReverse }</span>
				<button
					class="btn"
					hx-delete={ settingsRelationshipTypeDeleteURL(rt.ID) }
					hx-target={ "#" + settingsRelationshipTypesBodyID }
					hx-swap="outerHTML"
					hx-confirm="Remove this relationship type? This removes every relationship using it, not just the choice — that data doesn't come back."
				>
					Remove
				</button>
			</div>
		}
		<form
			class="inline-form"
			hx-post={ settingsRelationshipTypeCreateURL() }
			hx-target={ "#" + settingsRelationshipTypesBodyID }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input type="text" name="name" placeholder="Name (e.g. Coworker)" required/>
			<input type="text" name="name_reverse" placeholder="Reverse name (e.g. Coworker)" required/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}
