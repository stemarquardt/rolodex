package templates

import (
	"rolodex/internal/model"
)

templ PersonDetail(detail *model.PersonDetail, otherPeople []model.Person, circles []model.Circle, relTypes []model.RelationshipType, contactInfoTypes, importantDateTypes []model.OptionValue) {
	@Layout("people", "People / Profile", detail.FullName(), "") {
		@PersonHeader(detail.Person)

		@ContactInfoSection(detail.ID, detail.ContactInfo, contactInfoTypes)
		@ImportantDatesSection(detail.ID, detail.ImportantDates, importantDateTypes)
		@RelationshipsSection(detail.ID, detail.Relationships, otherPeople, relTypes)
		@CirclesSection(detail.ID, detail.CircleMemberships, circles)
		@PetsSection(detail.ID, detail.Pets)
		@FactsSection(detail.ID, detail.Facts)
		@RemindersSection(detail.ID, detail.Reminders)
		@NotesSection(detail.ID, detail.Notes)
	}
}

templ PersonHeader(p model.Person) {
	<div class="panel" id={ personHeaderID(p.ID) }>
		<div style="display:flex;justify-content:space-between;align-items:flex-start;">
			<div>
				<div style="font-size:20px;font-weight:600;">{ p.FullName() }</div>
				if p.Nickname != "" {
					<div class="muted">&#34;{ p.Nickname }&#34;</div>
				}
				if p.Location != "" {
					<div class="muted">{ p.Location }</div>
				}
			</div>
			<div style="display:flex;gap:8px;">
				<button
					class="btn"
					hx-post={ personCheckInURL(p.ID) }
					hx-target={ "#" + noteListID(p.ID) }
					hx-swap="outerHTML"
					title="Logs a 'Checked in' note, which resets how long it's been since you last logged contact with this person"
				>
					Mark as caught up
				</button>
				<button class="btn" hx-get={ personEditURL(p.ID) } hx-target={ "#" + personHeaderID(p.ID) } hx-swap="outerHTML">Edit</button>
				<button
					class="btn"
					hx-delete={ personURL(p.ID) }
					hx-confirm="Delete this person? This removes everything attached to them."
					hx-target="body"
				>
					Delete person
				</button>
			</div>
		</div>
		<label class="muted" style="display:flex;align-items:center;gap:6px;margin-top:10px;">
			<input
				type="checkbox"
				checked?={ p.NudgeEnabled }
				hx-put={ personNudgeURL(p.ID) }
				hx-trigger="change"
				hx-vals="js:{nudge_enabled: event.target.checked}"
				hx-swap="none"
			/>
			Include in check-in nudges
		</label>
	</div>
}

templ PersonHeaderEdit(p model.Person) {
	<div class="panel" id={ personHeaderID(p.ID) }>
		<form hx-put={ personURL(p.ID) } hx-target={ "#" + personHeaderID(p.ID) } hx-swap="outerHTML">
			<div class="inline-form">
				<input type="text" name="first_name" placeholder="First name" value={ p.FirstName } required/>
				<input type="text" name="last_name" placeholder="Last name" value={ p.LastName }/>
				<input type="text" name="nickname" placeholder="Nickname" value={ p.Nickname }/>
			</div>
			<div class="inline-form">
				<input type="text" name="location" placeholder="Location" value={ p.Location }/>
				<label class="muted" style="display:flex;align-items:center;gap:6px;">
					<input type="checkbox" name="nudge_enabled" value="1" checked?={ p.NudgeEnabled }/>
					Include in check-in nudges
				</label>
			</div>
			<div style="display:flex;gap:8px;">
				<button class="btn btn-primary" type="submit">Save</button>
				<button
					class="btn"
					type="button"
					hx-get={ personHeaderURL(p.ID) }
					hx-target={ "#" + personHeaderID(p.ID) }
					hx-swap="outerHTML"
				>
					Cancel
				</button>
			</div>
		</form>
	</div>
}

templ ContactInfoSection(personID int64, items []model.ContactInfo, typeOptions []model.OptionValue) {
	<div class="panel">
		<div class="section-title">Contact information</div>
		@ContactInfoList(personID, items)
		<form
			class="inline-form"
			hx-post={ contactInfoCreateURL(personID) }
			hx-target={ "#" + contactInfoListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<select name="type" required>
				for _, o := range typeOptions {
					<option value={ o.Value }>{ o.Value }</option>
				}
			</select>
			<input type="text" name="value" placeholder="Value" required/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ ContactInfoList(personID int64, items []model.ContactInfo) {
	<div id={ contactInfoListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No contact info yet.</div>
		}
		for _, c := range items {
			<div class="list-row">
				<span class="muted" style="width:120px;text-transform:uppercase;font-size:11px;">{ c.Type }</span>
				<span style="flex:1;">{ c.Value }</span>
				<button
					class="btn"
					hx-delete={ contactInfoDeleteURL(personID, c.ID) }
					hx-target={ "#" + contactInfoListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this contact info?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ ImportantDatesSection(personID int64, items []model.ImportantDate, typeOptions []model.OptionValue) {
	<div class="panel">
		<div class="section-title">Important dates</div>
		@ImportantDatesList(personID, items)
		<form
			class="inline-form"
			hx-post={ importantDateCreateURL(personID) }
			hx-target={ "#" + importantDateListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<select name="type" required>
				for _, o := range typeOptions {
					<option value={ o.Value }>{ o.Value }</option>
				}
			</select>
			<input type="text" name="label" placeholder="Label (optional — defaults to type)"/>
			<select name="month" required>
				<option value="" disabled selected>Month</option>
				for i, name := range monthNames {
					if i > 0 {
						<option value={ idStr(int64(i)) }>{ name }</option>
					}
				}
			</select>
			<input type="number" name="day" placeholder="Day" min="1" max="31" required style="width:70px;"/>
			<input type="number" name="year" placeholder="Year (optional)" style="width:110px;"/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ ImportantDatesList(personID int64, items []model.ImportantDate) {
	<div id={ importantDateListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No important dates yet.</div>
		}
		for _, d := range items {
			<div class="list-row">
				<span class="tag">{ d.Label }</span>
				<span class="muted" style="flex:1;">{ formatImportantDate(d) }</span>
				<button
					class="btn"
					hx-delete={ importantDateDeleteURL(personID, d.ID) }
					hx-target={ "#" + importantDateListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this date?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ RelationshipsSection(personID int64, items []model.RelationshipView, otherPeople []model.Person, relTypes []model.RelationshipType) {
	<div class="panel">
		<div class="section-title">Relationships</div>
		@RelationshipsList(personID, items)
		if len(otherPeople) > 0 && len(relTypes) > 0 {
			<form
				class="inline-form"
				hx-post={ relationshipCreateURL(personID) }
				hx-target={ "#" + relationshipListID(personID) }
				hx-swap="outerHTML"
			>
				<span class="muted">This person is the</span>
				<select name="relationship_type_id">
					for _, t := range relTypes {
						<option value={ idStr(t.ID) }>{ t.Name }</option>
					}
				</select>
				<span class="muted">of</span>
				<select name="related_person_id">
					for _, p := range otherPeople {
						<option value={ idStr(p.ID) }>{ p.FullName() }</option>
					}
				</select>
				<button class="btn" type="submit">+ Add</button>
			</form>
		}
	</div>
}

templ RelationshipsList(personID int64, items []model.RelationshipView) {
	<div id={ relationshipListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No relationships recorded yet.</div>
		}
		for _, r := range items {
			<div class="list-row">
				<span class="tag">{ r.TypeName }</span>
				<a href={ templ.URL(personURL(r.RelatedPersonID)) } style="flex:1;">{ r.RelatedName }</a>
				<button
					class="btn"
					hx-delete={ relationshipDeleteURL(personID, r.ID) }
					hx-target={ "#" + relationshipListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this relationship?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ CirclesSection(personID int64, items []model.CircleMembership, circles []model.Circle) {
	<div class="panel">
		<div class="section-title">Circles</div>
		@CirclesList(personID, items)
		<form
			class="inline-form"
			hx-post={ circleCreateURL(personID) }
			hx-target={ "#" + circleListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input list="circle-options" type="text" name="circle_name" placeholder="Circle name" required/>
			<datalist id="circle-options">
				for _, c := range circles {
					<option value={ c.Name }></option>
				}
			</datalist>
			<input type="text" name="note" placeholder="Context (optional)"/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ CirclesList(personID int64, items []model.CircleMembership) {
	<div id={ circleListID(personID) }>
		if len(items) == 0 {
			<div class="muted">Not part of any circles yet.</div>
		}
		for _, m := range items {
			<div class="list-row">
				<span class="tag">{ m.CircleName }</span>
				if m.Note.Valid && m.Note.String != "" {
					<span class="muted" style="flex:1;">{ m.Note.String }</span>
				} else {
					<span style="flex:1;"></span>
				}
				<button
					class="btn"
					hx-delete={ circleDeleteURL(personID, m.CircleID) }
					hx-target={ "#" + circleListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove from this circle?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ PetsSection(personID int64, items []model.Pet) {
	<div class="panel">
		<div class="section-title">Pets</div>
		@PetsList(personID, items)
		<form
			class="inline-form"
			hx-post={ petCreateURL(personID) }
			hx-target={ "#" + petListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input type="text" name="name" placeholder="Name" required/>
			<input type="text" name="species" placeholder="Species"/>
			<input type="text" name="notes" placeholder="Notes"/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ PetsList(personID int64, items []model.Pet) {
	<div id={ petListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No pets recorded.</div>
		}
		for _, p := range items {
			<div class="list-row">
				<span>{ p.Name }</span>
				<span class="muted" style="flex:1;">{ p.Species }</span>
				if p.Notes != "" {
					<span class="tag">{ p.Notes }</span>
				}
				<button
					class="btn"
					hx-delete={ petDeleteURL(personID, p.ID) }
					hx-target={ "#" + petListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this pet?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ FactsSection(personID int64, items []model.Fact) {
	<div class="panel">
		<div class="section-title">Quick facts</div>
		@FactsList(personID, items)
		<form
			class="inline-form"
			hx-post={ factCreateURL(personID) }
			hx-target={ "#" + factListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input type="text" name="label" placeholder="Label (e.g. Go-to order)" required/>
			<input type="text" name="value" placeholder="Value" required/>
			<button class="btn" type="submit">+ Add</button>
		</form>
	</div>
}

templ FactsList(personID int64, items []model.Fact) {
	<div id={ factListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No quick facts yet.</div>
		}
		for _, f := range items {
			<div class="list-row">
				<span class="muted" style="width:160px;text-transform:uppercase;font-size:11px;">{ f.Label }</span>
				<span style="flex:1;">{ f.Value }</span>
				<button
					class="btn"
					hx-delete={ factDeleteURL(personID, f.ID) }
					hx-target={ "#" + factListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this fact?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}

templ RemindersSection(personID int64, items []model.Reminder) {
	<div class="panel">
		<div class="section-title">Reminders</div>
		<form
			class="inline-form"
			hx-post={ personReminderCreateURL(personID) }
			hx-target={ "#" + personReminderListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<input type="text" name="note" placeholder="Remind me to..." required style="flex:1;"/>
			<input type="date" name="due_date" required/>
			<input type="number" name="recurrence_interval" placeholder="Every" min="1" style="width:70px;"/>
			<select name="recurrence_unit">
				<option value="">(one-off)</option>
				<option value="days">days</option>
				<option value="weeks">weeks</option>
				<option value="months">months</option>
			</select>
			<button class="btn" type="submit">+ Add</button>
		</form>
		@PersonRemindersList(personID, items)
	</div>
}

templ PersonRemindersList(personID int64, items []model.Reminder) {
	<div id={ personReminderListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No reminders for this person yet.</div>
		}
		for _, r := range items {
			<div class="list-row">
				<span style="flex:1;">
					{ r.Note }
					if r.Status == "done" {
						<span class="muted"> · done</span>
					}
				</span>
				if r.Recurring() {
					<span class="tag">recurring</span>
				}
				<span class="muted" style="width:100px;">{ r.DueDate }</span>
				if r.Status != "done" {
					<button
						class="btn"
						hx-post={ personReminderCompleteURL(personID, r.ID) }
						hx-target={ "#" + personReminderListID(personID) }
						hx-swap="outerHTML"
					>
						Mark done
					</button>
				}
				<button
					class="btn"
					hx-delete={ personReminderDeleteURL(personID, r.ID) }
					hx-target={ "#" + personReminderListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Delete this reminder?"
				>
					Delete
				</button>
			</div>
		}
	</div>
}

templ NotesSection(personID int64, items []model.Note) {
	<div class="panel">
		<div class="section-title">Notes</div>
		<form
			class="inline-form"
			hx-post={ noteCreateURL(personID) }
			hx-target={ "#" + noteListID(personID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<textarea name="body" placeholder="Add a note..." required></textarea>
			<button class="btn" type="submit">+ Add</button>
		</form>
		@NotesList(personID, items)
	</div>
}

templ NotesList(personID int64, items []model.Note) {
	<div id={ noteListID(personID) }>
		if len(items) == 0 {
			<div class="muted">No notes logged yet.</div>
		}
		for _, n := range items {
			<div class="list-row">
				<span class="muted" style="width:160px;">{ n.CreatedAt }</span>
				<span style="flex:1;">{ n.Body }</span>
				<button
					class="btn"
					hx-delete={ noteDeleteURL(personID, n.ID) }
					hx-target={ "#" + noteListID(personID) }
					hx-swap="outerHTML"
					hx-confirm="Remove this note?"
				>
					Remove
				</button>
			</div>
		}
	</div>
}
